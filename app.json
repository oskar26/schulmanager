{
  "expo": {
    "name": "Schulflow",
    "slug": "schulflow",
    "version": "1.0.0",
    "scheme": "schulflow",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": { "image": "./assets/splash-icon.png", "resizeMode": "contain", "backgroundColor": "#0B1020" },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.schulflow.client",
      "infoPlist": { "NSFaceIDUsageDescription": "Schütze deine Noten mit Face ID." }
    },
    "android": {
      "package": "app.schulflow.client",
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#6C5CE7" },
      "edgeToEdgeEnabled": true
    },
    "web": { "bundler": "metro", "output": "single", "favicon": "./assets/favicon.png" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      ["expo-notifications", { "color": "#6C5CE7" }]
    ],
    "experiments": { "typedRoutes": false }
  }
}
