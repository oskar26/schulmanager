{
  "expo": {
    "name": "Schulflow",
    "slug": "schulflow",
    "version": "1.0.0",
    "scheme": "schulflow",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": { "image": "./assets/splash-icon.png", "resizeMode": "contain", "backgroundColor": "#101114" },
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": false,
      "bundleIdentifier": "app.schulflow.client",
      "infoPlist": { "NSFaceIDUsageDescription": "Schütze deine Noten mit Face ID." }
    },
    "android": {
      "package": "app.schulflow.client",
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#FF8C38" },
      "edgeToEdgeEnabled": true
    },
    "web": { "bundler": "metro", "output": "single", "favicon": "./public/favicon.png", "lang": "de" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      ["expo-notifications", { "color": "#FF8C38" }]
    ],
    "experiments": { "typedRoutes": false }
  }
}
